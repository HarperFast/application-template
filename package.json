{
  "name": "application-template",
  "version": "1.0.0",
  "description": "A template for building Harper applications",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "start": "harper run .",
    "dev": "harper dev .",
    "login": "node login.js",
    "deploy": "npx -y dotenv-cli -- harper deploy . restart=rolling replicated=true",
    "test:integration": "harper-integration-test-run --isolation=none \"integrationTests/**/*.test.ts\""
  },
  "devDependencies": {
    "@harperfast/integration-testing": "^0.3.1",
    "@types/node": "^22.0.0",
    "harper": "^5.2.1"
  }
}
